# Public URL used for canonical links, the sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://abcore.ae

# Demo request form (optional).
# Without RESEND_API_KEY the form opens the visitor's email app with the request filled in.
RESEND_API_KEY=
DEMO_REQUEST_TO=contact@abcore.ae
DEMO_REQUEST_FROM="AB'CORE Website <website@abcore.ae>"
